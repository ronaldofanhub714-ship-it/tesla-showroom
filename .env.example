# ── Supabase (public — safe to commit) ────────────────────────────
# Also add both as GitHub → Settings → Secrets and variables → Actions → Variables
# so the CI build can inline them into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://ztcejxyfcadzxoobqkaa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KGDgARm90UnkPLh6ZQ7HLQ_U4KmIUgd

# ── Secrets — NEVER commit real values ────────────────────────────
# Set in: Cloudflare Dashboard → Workers & Pages → market-cron-worker
#         → Settings → Variables and Secrets (mark as Secret)
# Used only by the cron worker to upsert market_data.
SUPABASE_SERVICE_SECRET=

# ── CI/CD — GitHub repo → Settings → Secrets and variables → Actions ──
CLOUDFLARE_API_TOKEN=

# NOTE: No JWT_SECRET needed — we rely on Supabase-issued session JWTs
# instead of minting our own cookies.
