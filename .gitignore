# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js / OpenNext build output ─────────────────────────────
.next/
.open-next/
out/
build/

# ── Cloudflare Wrangler local state ─────────────────────────────
.wrangler/
worker/.wrangler/
