.dev.vars
worker/.dev.vars

# ── Environment variables ───────────────────────────────────────
# Only .env.example is committed
.env
.env.local
.env.*.local

# ── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Logs / debug ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── OS / editor ─────────────────────────────────────────────────
.DS_Store
*.pem
.vscode/
.idea/
